{
    "name": "omnischolar/openlibrary",
    "type": "library",
    "description": "Omnischolar Open Library: an author's books, one record per edition with ISBNs, publisher and cover, for the Merger to group - no key.",
    "keywords": [
        "scholarly",
        "publications",
        "openlibrary",
        "books",
        "isbn",
        "covers",
        "omnischolar"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "require": {
        "php": ">=8.2",
        "glitchr/omnischolar": "^1.0@dev",
        "symfony/http-client": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Omnischolar\\OpenLibrary\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Omnischolar\\OpenLibrary\\Tests\\": "Tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
